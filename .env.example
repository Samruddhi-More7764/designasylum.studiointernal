# Neon Postgres (pooled connection string is fine)
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Alias accepted by Payload if POSTGRES_URL is unset
# DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Random string, at least 32 characters. Never commit the real value.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public origin of this Next.js app (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google Tag Manager (public marketing site only — not /admin)
NEXT_PUBLIC_GTM_ID=GTM-TP3F8PRP

# Vercel Blob — required for production uploads. Create a Blob store in Vercel
# and paste the token. If unset, Payload stores files in a local `media/` folder.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: set to "false" after you start using `npm run migrate`
# PAYLOAD_PUSH=true

# Homepage contact form → Google Sheet.
# Share the sheet with the service account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
# Local: absolute path to the service-account JSON
GOOGLE_SERVICE_ACCOUNT_PATH=
# Production (Vercel): paste the JSON as a single-line string instead
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
